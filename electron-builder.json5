{
  appId: "pl.piecioshka.battery-life-extender",
  productName: "Battery Life Extender",
  copyright: "Copyright © 2019 Piotr 'piecioshka' Kowalski",
  asar: true,
  // Releases are created by the CI release job from the uploaded artifacts,
  // never by electron-builder itself (it would publish from a tag build).
  publish: null,
  files: ["!**/*.test.js", "!screenshots/**", "!tmp/**", "!README.md"],
  mac: {
    target: [
      { target: "dmg", arch: ["arm64", "x64"] },
      { target: "zip", arch: ["arm64", "x64"] },
    ],
    icon: "./icons/app-icon.png",
    category: "public.app-category.utilities",
    // No Developer ID certificate, so the app gets an ad-hoc signature.
    // Without it Apple silicon reports the downloaded app as "damaged"
    // instead of showing the regular "cannot be verified" prompt.
    identity: "-",
  },
}
